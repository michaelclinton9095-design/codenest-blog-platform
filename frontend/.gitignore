# Environment Variables
.env
.env.*
*.env
*.local
!.env.example

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Linters
.eslintcache
.stylelintcache

# OS & IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sw?
*.bak
*.tmp
